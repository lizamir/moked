# Only needed for the LLM parts (agent, re-ranker, agent eval).
# Retrieval eval, unit tests and the MCP server run without it.
ANTHROPIC_API_KEY=
# Optional overrides
# MOKED_AGENT_MODEL=claude-opus-5-5
# MOKED_RERANK_MODEL=claude-haiku-5-5
# WhatsApp (only for npm run whatsapp; see docs/whatsapp.md)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Jira (optional): staff requests also open a Jira ticket. Set all four or none.
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=
