{
  "name": "moked",
  "version": "0.1.0",
  "description": "Business AI agent in TypeScript: Hebrew RAG over a knowledge base, web search, and approval-gated actions (booking, email, staff requests), with an MCP server and an eval suite",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ask": "tsx src/interfaces/cli.ts",
    "mcp": "tsx src/interfaces/mcp-server.ts",
    "eval:retrieval": "tsx evals/retrieval.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p site",
    "build:site": "tsx scripts/build-site.ts",
    "chat": "tsx src/interfaces/cli.ts",
    "eval:agent": "tsx evals/agent.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
